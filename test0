import requests
import random

# List of example URLs to choose from
urls = ["https://www.example.com", "https://jsonplaceholder.typicode.com/posts", "https://httpbin.org/get"]

# Choose a random URL
url = random.choice(urls)

# Send GET request
response = requests.get(url)

# Check if status code is 200
if response.status_code == 200:
    # Check the first letter of the response text
    first_letter = response.text.strip()[0]
    if first_letter == "A":
        print("A!")
    elif first_letter == "B":
        print("B!")